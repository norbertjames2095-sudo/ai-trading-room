# ============================================
# AI TRADING ROOM - Environment Configuration
# ============================================
# Copy this file to .env and update values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://trading:trading_password@postgres:5432/trading_room
DATABASE_ECHO=false

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# ============================================
# BACKEND
# ============================================
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_WORKERS=4
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true
CORS_ALLOW_HEADERS=*
CORS_ALLOW_METHODS=*

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ============================================
# AI MODELS & PROVIDERS
# ============================================
# OpenAI
OPENAI_API_KEY=your-openai-key
OPENAI_FAST_MODEL=gpt-3.5-turbo
OPENAI_POWERFUL_MODEL=gpt-4

# Anthropic (alternative)
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_FAST_MODEL=claude-3-haiku-20240307
ANTHROPIC_POWERFUL_MODEL=claude-3-opus-20240229

# Default AI Provider
AI_PROVIDER=openai
AI_FAST_MODEL=gpt-3.5-turbo
AI_POWERFUL_MODEL=gpt-4

# ============================================
# MARKET DATA PROVIDERS
# ============================================
# Alpha Vantage
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# IEX Cloud
IEX_CLOUD_API_KEY=your-iex-cloud-key

# CoinGecko (free tier for crypto)
COINGECKO_API_KEY=your-coingecko-key

# Polygon.io
POLYGON_API_KEY=your-polygon-key

# Primary Market Data Provider
MARKET_DATA_PROVIDER=alpha-vantage

# ============================================
# NEWS & SENTIMENT
# ============================================
NEWSAPI_API_KEY=your-newsapi-key
FINHUB_API_KEY=your-finhubc-key

# ============================================
# BROKER API (Paper Trading)
# ============================================
# Alpaca
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Interactive Brokers (future)
IB_ACCOUNT=DU123456
IB_CLIENT_ID=your-ib-client-id

# ============================================
# RISK ENGINE DEFAULTS
# ============================================
RISK_MAX_PER_TRADE=0.02  # 2% of portfolio
RISK_MAX_EXPOSURE_PER_ASSET=0.10  # 10% of portfolio
RISK_MAX_TOTAL_EXPOSURE=0.80  # 80% of portfolio
RISK_MAX_DAILY_LOSS=0.05  # 5% of portfolio per day
RISK_MAX_DRAWDOWN=0.20  # 20% max drawdown
RISK_MAX_POSITIONS=20
RISK_MIN_LIQUIDITY_RATIO=2.0  # min (position / daily volume)
RISK_MAX_SLIPPAGE_BPS=50  # 50 basis points
RISK_MAX_CORRELATION=0.95  # max correlation between positions
RISK_VOLATILITY_LIMIT=0.15  # 15% max volatility

# ============================================
# AI COST MANAGEMENT
# ============================================
AI_BUDGET_MONTHLY_USD=1000.0
AI_BUDGET_ALERT_PERCENT=80  # Alert at 80% of budget
AI_REDUCE_CALLS_WHEN_BUDGET=90  # Reduce calls at 90% of budget
AI_TRACK_PER_MODEL=true
AI_TRACK_PER_AGENT=true

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# ============================================
# NOTIFICATIONS
# ============================================
# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@tradingroom.ai
ALERT_EMAIL=your-email@example.com

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================
# DEVELOPMENT
# ============================================
DEBUG=false
TESTING=false
ENVIRONMENT=development

# ============================================
# SECURITY
# ============================================
SESSION_TIMEOUT_MINUTES=30
2FA_ENABLED=true
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIMEOUT_MINUTES=15

# ============================================
# TRADING MODES
# ============================================
TRADING_MODE=paper  # research, backtest, paper, live
REQUIRE_MANUAL_APPROVAL=true
LIVE_MODE_ENABLED=false  # MUST be explicitly enabled
LIVE_MODE_REQUIRES_2FA=true

# ============================================
# BACKTESTING
# ============================================
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_COMMISSION=0.001  # 0.1%
BACKTEST_SLIPPAGE_BPS=5  # 5 basis points
BACKTEST_WARM_UP_DAYS=30

# ============================================
# DATA RETENTION
# ============================================
RETENTION_DAYS_TRADES=730  # 2 years
RETENTION_DAYS_LOGS=90  # 3 months
RETENTION_DAYS_AUDIT=3650  # 10 years
RETENTION_DAYS_MARKET_DATA=730  # 2 years
